{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "env": {}
    },
    "pencil": {
      "command": "/Applications/Pencil.app/Contents/Resources/app.asar.unpacked/out/mcp-server-darwin-arm64",
      "args": [
        "--app",
        "desktop",
        "--agent",
        "claudeCodeCLI"
      ],
      "env": {},
      "type": "stdio"
    },
    "higgsfield": {
      "type": "http",
      "url": "https://mcp.higgsfield.ai/mcp"
    },
    "blender": {
      "type": "stdio",
      "command": "/Users/izabirov/.local/bin/uvx",
      "args": [
        "blender-mcp"
      ],
      "env": {}
    }
  }
}